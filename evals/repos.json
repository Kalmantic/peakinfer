      {
        "name": "databricks-sdk-py",
        "url": "https://github.com/databricks/databricks-sdk-py",
        "expected_providers": ["databricks"],
        "expected_patterns": ["serving_endpoints", "foundation_models"],
        "prd_reference": "DET-308: Databricks SDK, /serving-endpoints/",
        "priority": 1
      },
      {
        "name": "databricks-ml-examples",
        "url": "https://github.com/databricks/databricks-ml-examples",
        "expected_providers": ["databricks"],
        "expected_patterns": ["model_serving", "mosaic_ml"],
        "priority": 1
      },
      {
        "name": "snowflake-ml-python",
        "url": "https://github.com/snowflakedb/snowflake-ml-python",
        "expected_providers": ["snowflake"],
        "expected_patterns": ["cortex", "snowpark_ml"],
        "prd_reference": "DET-309: snowflake.cortex",
