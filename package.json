{
  "name": "@kalmantic/peakinfer",
  "version": "1.0.50",
  "description": "LLM inference performance analysis CLI",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "peakinfer": "dist/cli.js"
  },
  "scripts": {
    "prebuild": "npm version patch --no-git-tag-version",
    "build": "tsc",
    "build:noversion": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "llm",
    "inference",
    "performance",
    "analysis",
    "openai",
    "anthropic"
  ],
  "author": "Kalmantic AI Labs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kalmantic/peakinfer"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "chalk": "^5.6.2",
    "commander": "^12.0.0",
    "dotenv": "^17.2.3",
    "glob": "^10.3.10",
    "ignore": "^5.3.0",
    "ora": "^9.0.0",
    "puppeteer": "^24.33.0",
    "yaml": "^2.3.4",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
