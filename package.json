{
  "name": "@kalmantic/peakinfer",
  "version": "0.1.0",
  "description": "Multi-agent LLM inference optimization using Claude SDK - analyze and optimize across Application, Serving, and Infrastructure layers",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "peakinfer": "dist/cli-new.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "start": "node dist/cli-new.js"
  },
  "keywords": [
    "llm",
    "optimization",
    "inference",
    "claude",
    "anthropic",
    "multi-agent",
    "cost-optimization",
    "ai",
    "ml",
    "mlops",
    "token-squeeze",
    "vllm",
    "templates",
    "economics"
  ],
  "author": "Kalmantic AI Labs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kalmantic/peakinfer"
  },
  "bugs": {
    "url": "https://github.com/kalmantic/peakinfer/issues"
  },
  "homepage": "https://github.com/kalmantic/peakinfer#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "ignore": "^7.0.5",
    "jsonrepair": "^3.13.1",
    "ora": "^7.0.1",
    "uuid": "^9.0.1",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
