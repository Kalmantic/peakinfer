{
  "name": "@kalmantic/peakinfer",
  "version": "0.95.0",
  "description": "Peak performance of inference - analyze and optimize across Application, Serving, and Infrastructure layers",
  "main": "dist/slc/index.js",
  "type": "module",
  "bin": {
    "peakinfer": "dist/slc/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/slc/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "start": "node dist/slc/cli.js",
    "validate": "chmod +x test-codebase/run-peakinfer-tests.sh && ./test-codebase/run-peakinfer-tests.sh"
  },
  "keywords": [
    "llm",
    "optimization",
    "inference",
    "claude",
    "anthropic",
    "multi-agent",
    "cost-optimization",
    "ai",
    "ml",
    "mlops",
    "token-squeeze",
    "vllm",
    "templates",
    "economics"
  ],
  "author": "Kalmantic AI Labs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kalmantic/peakinfer"
  },
  "bugs": {
    "url": "https://github.com/kalmantic/peakinfer/issues"
  },
  "homepage": "https://github.com/kalmantic/peakinfer#readme",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.55",
    "@anthropic-ai/sdk": "^0.27.3",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "fs-extra": "^11.3.2",
    "glob": "^10.3.10",
    "hcl2-json-parser": "^1.0.1",
    "ignore": "^7.0.5",
    "jsonrepair": "^3.13.1",
    "openai": "^6.9.1",
    "ora": "^7.0.1",
    "snowflake-sdk": "^2.3.1",
    "uuid": "^9.0.1",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/commander": "^2.12.5",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
